# Mẫu cấu hình môi trường cho docker compose.
# Cách dùng: copy file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# ---------- Cổng mở ra máy host ----------
FRONTEND_PORT=4200
BACKEND_PORT=8080
POSTGRES_PORT=5432

# ---------- PostgreSQL ----------
# Lưu ý: user/mật khẩu chỉ áp dụng khi tạo volume lần đầu.
# Đổi sau đó phải xóa volume: docker compose down -v (MẤT DỮ LIỆU).
DB_NAME=smartmall
DB_USERNAME=smartmall
DB_PASSWORD=change-me

# ---------- Backend ----------
# dev: bật tài khoản mẫu + log DEBUG. Môi trường thật đặt prod (hoặc bỏ trống profile dev).
SPRING_PROFILES_ACTIVE=dev
# Khóa ký JWT, tối thiểu 32 ký tự. Sinh ngẫu nhiên, ví dụ: openssl rand -base64 48
JWT_SECRET=
# Origin của frontend được phép gọi API trực tiếp (khi không đi qua nginx)
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Mật khẩu chung cho tài khoản mẫu admin/ketoan/kythuat (chỉ profile dev)
DEV_SEED_PASSWORD=change-me
